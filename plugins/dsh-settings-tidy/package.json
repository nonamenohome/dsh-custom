{
  "name": "dsh-settings-tidy",
  "version": "0.1.0",
  "private": true,
  "description": "整理 DSH 设置左侧导航：隐藏在其他位置已有入口的重复分区，并把同类分区排到相邻位置。纯客户端 DOM 整理，不改任何插件源码。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
